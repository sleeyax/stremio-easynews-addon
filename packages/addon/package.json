{
  "name": "@easynews/addon",
  "version": "1.3.8",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "start": "node dist/server.js",
    "start:dev": "cross-env NODE_ENV=dev tsx watch src/server.ts"
  },
  "description": "Provides content from Easynews & includes a search catalog. This addon can also be self-hosted.",
  "dependencies": {
    "@easynews/api": "workspace:*",
    "@stremio-addon/compat": "^0.0.6",
    "@stremio-addon/sdk": "^0.1.0",
    "parse-torrent-title": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "cross-env": "^7.0.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.5"
  }
}
