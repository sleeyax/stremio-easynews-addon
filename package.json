{
  "name": "@easynews/core",
  "version": "1.3.8",
  "main": "dist/server.js",
  "scripts": {
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "build": "pnpm -r build",
    "build:watch": "tsc --build --watch",
    "start:addon": "pnpm --filter @easynews/addon run start",
    "start:addon:dev": "pnpm --filter @easynews/addon run start:dev",
    "start:cloudflare-worker:dev": "pnpm --filter @easynews/cloudflare-worker run dev",
    "deploy:beamup": "beamup",
    "deploy:cloudflare-worker": "pnpm --filter @easynews/cloudflare-worker run deploy",
    "version": "pnpm -r pkg set version=$npm_package_version && git add packages/*/package.json"
  },
  "keywords": [
    "stremio easynews addon",
    "stremio easynews"
  ],
  "author": "Sleeyax",
  "license": "MIT",
  "description": "Provides content from Easynews & includes a search catalog. This addon can also be self-hosted.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "devDependencies": {
    "beamup-cli": "^1.3.2",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  }
}
